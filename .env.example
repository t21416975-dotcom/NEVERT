# Supabase project credentials (from Supabase Dashboard > Settings > API)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only (order writing, admin). NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Workshop WhatsApp number, international format without + or spaces (e.g. 201234567890)
PUBLIC_WHATSAPP_NUMBER=
