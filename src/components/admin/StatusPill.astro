---
import { shortStatusLabel, statusPillClass } from '../../lib/labels';
import type { OrderStatus } from '../../lib/types';

interface Props {
  status: OrderStatus;
}

const { status } = Astro.props;
---

<span class={`admin-pill ${statusPillClass[status] ?? 'bg-linen text-stone'}`}>
  <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
  {shortStatusLabel[status] ?? status}
</span>
