---
import { listCollections } from '../lib/store';

const year = new Date().getFullYear();
// Featured collections (ticked in /admin/collections) appear under "Shop".
// If none are ticked yet, fall back to all collections so the column is useful.
const all = await listCollections();
const shopLinks = (all.some((c) => c.featured) ? all.filter((c) => c.featured) : all).slice(0, 4);
---

<footer class="mt-24 border-t border-espresso/10 bg-linen/60">
  <div class="mx-auto max-w-6xl px-5 py-10 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="sm:max-w-xs">
        <p class="font-display text-xl tracking-[0.2em] text-espresso">NEVERT</p>
        <p
          data-i18n="footer.tagline"
          class="mt-2 text-sm leading-relaxed text-stone"
        >
          Bags cut, stitched and finished by four pairs of hands in a small
          workshop. No assembly lines.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-6 text-sm sm:gap-x-16">
        {shopLinks.length > 0 && (
          <div>
            <p data-i18n="footer.shop" class="text-espresso">Shop</p>
            <ul class="mt-2.5 space-y-1.5 text-stone">
              {shopLinks.map((c) => (
                <li>
                  <a
                    class="hover:text-cognac"
                    href={`/collections/${c.slug}`}
                    data-en={c.name}
                    data-ar={c.name_ar || c.name}
                  >
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div>
          <p data-i18n="footer.questions" class="text-espresso">Questions</p>
          <ul class="mt-2.5 space-y-1.5 text-stone">
            <li><a class="hover:text-cognac" data-i18n="nav.about" href="/about">About us</a></li>
            <li><a class="hover:text-cognac" data-i18n="footer.contact" href="/contact">Contact us</a></li>
            <li><a class="hover:text-cognac" data-i18n="footer.bag" href="/cart">Your bag</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-8 border-t border-espresso/10 pt-5 text-xs text-stone">
      © {year} NEVERT.
      <span data-i18n="footer.note">Orders are confirmed over WhatsApp.</span>
    </div>
  </div>
</footer>
