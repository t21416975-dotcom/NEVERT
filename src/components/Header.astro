---
import CartBadge from './CartBadge.tsx';
import LangToggle from './LangToggle.tsx';

interface Props {
  /** Transparent header that floats over a full-screen hero and turns solid on scroll */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const links = [
    { href: '/collections', label: 'Collections', i18n: 'nav.collections' },
  { href: '/about', label: 'The atelier', i18n: 'nav.atelier' },
  { href: '/contact', label: 'Contact', i18n: 'nav.contact' },
];
const path = Astro.url.pathname;
---

<header
  class:list={[
    'site-header top-0 z-50 border-b',
    overlay
      ? 'site-header--overlay fixed inset-x-0 border-transparent bg-transparent'
      : 'sticky border-espresso/10 bg-porcelain/85 backdrop-blur-sm',
  ]}
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
    <a
      href="/"
      class="header-fg font-display text-2xl tracking-[0.22em] text-espresso transition-colors duration-500"
      aria-label="NEVERT, home"
    >
      NEVERT
    </a>

    <nav class="hidden gap-8 sm:flex" aria-label="Main">
      {
        links.map((l) => (
                    <a
            href={l.href}
            data-i18n={l.i18n}
            class:list={[
              'header-fg font-body text-sm tracking-[0.06em] transition-colors duration-500 hover:text-cognac',
              path.startsWith(l.href) ? 'text-cognac' : 'text-espresso/80',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
            <div class="header-fg transition-colors duration-500">
        <LangToggle client:load />
      </div>
      <div class="header-fg transition-colors duration-500">
        <CartBadge client:load />
      </div>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="header-fg -me-1 flex h-9 w-9 items-center justify-center text-espresso transition-colors duration-500 hover:text-cognac sm:hidden"
      >
        <svg
          data-icon-open
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg
          data-icon-close
          class="hidden"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- mobile menu: the key pages, one tap away -->
  <nav
    id="mobile-menu"
    data-menu-panel
    class="hidden border-t border-espresso/10 bg-porcelain/95 backdrop-blur-sm sm:hidden"
    aria-label="Mobile"
  >
    <ul class="mx-auto flex max-w-6xl flex-col px-5 py-2">
      {
        links.map((l) => (
          <li>
                        <a
              href={l.href}
              data-i18n={l.i18n}
              class:list={[
                'block border-b border-espresso/5 py-3.5 font-body text-base tracking-[0.04em] transition-colors hover:text-cognac',
                path.startsWith(l.href) ? 'text-cognac' : 'text-espresso',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const menuButton = document.querySelector('[data-menu-button]');
  const menuPanel = document.querySelector('[data-menu-panel]');
  if (menuButton && menuPanel) {
    const iconOpen = menuButton.querySelector('[data-icon-open]');
    const iconClose = menuButton.querySelector('[data-icon-close]');
    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      menuPanel.classList.toggle('hidden', isOpen);
      iconOpen?.classList.toggle('hidden', !isOpen);
      iconClose?.classList.toggle('hidden', isOpen);
    });
  }
</script>

{
  overlay && (
    <script>
      const header = document.querySelector('.site-header--overlay');
      if (header) {
        const update = () =>
          header.classList.toggle('is-solid', window.scrollY > 32);
        update();
        window.addEventListener('scroll', update, { passive: true });
      }
    </script>
  )
}
