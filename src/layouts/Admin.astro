---
import '../styles/global.css';
import { orderStatusLabel } from '../lib/labels';

interface Props {
  title: string;
  email?: string;
  newOrders?: number;
}

const { title, email, newOrders = 0 } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/admin', label: 'الطلبات', match: /^\/admin(\/orders)?(\/.*)?$/, badge: newOrders },
  { href: '/admin/products', label: 'المنتجات', match: /^\/admin\/products/ },
  { href: '/admin/collections', label: 'المجموعات', match: /^\/admin\/collections/ },
  { href: '/admin/hero', label: 'صور الرئيسية', match: /^\/admin\/hero/ },
];
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/plex-300.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/amiri-400.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <style is:global>
      body {
        font-family: 'IBM Plex Sans Arabic', system-ui, sans-serif;
      }
      h1,
      h2,
      h3,
      h4 {
        font-family: Amiri, 'IBM Plex Sans Arabic', serif;
        letter-spacing: 0;
      }
      .latin {
        font-family: 'IBM Plex Sans Arabic', system-ui, sans-serif;
        direction: ltr;
        unicode-bidi: isolate;
        display: inline-block;
      }
    </style>
  </head>
  <body class="min-h-screen bg-porcelain text-espresso antialiased">
    <header class="sticky top-0 z-40 border-b border-espresso/10 bg-porcelain/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-3 sm:px-8">
        <div class="flex items-center gap-4">
          <a href="/admin" class="font-display text-xl tracking-[0.2em] text-espresso">
            NEVERT
          </a>
          <span class="hidden rounded-full bg-linen px-3 py-1 text-xs text-stone sm:inline">لوحة التحكم</span>
        </div>
        <div class="flex items-center gap-2 sm:gap-3">
          {email && <span class="latin hidden text-xs text-stone md:inline">{email}</span>}
          <a href="/admin/products#new" class="admin-btn !px-4 !py-2 text-xs">＋ منتج جديد</a>
          <a href="/" class="admin-btn-ghost !border-0 !px-3 !py-2 text-xs">عرض المتجر</a>
          <form method="post" action="/api/admin/logout">
            <button
              type="submit"
              class="px-2 py-2 text-xs text-stone underline decoration-stone/30 underline-offset-4 hover:text-cognac"
            >
              خروج
            </button>
          </form>
        </div>
      </div>
      <nav class="mx-auto max-w-6xl px-5 pb-3 sm:px-8" aria-label="أقسام اللوحة">
        <ul class="flex gap-2">
          {
            nav.map((item) => {
              const active = item.match.test(path);
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm transition-colors',
                      active
                        ? 'bg-espresso text-porcelain'
                        : 'text-stone hover:bg-linen hover:text-espresso',
                    ]}
                  >
                    {item.label}
                    {(item.badge ?? 0) > 0 && (
                      <span
                        class:list={[
                          'latin rounded-full px-2 py-0.5 text-xs',
                          active ? 'bg-porcelain/20 text-porcelain' : 'bg-cognac text-porcelain',
                        ]}
                      >
                        {item.badge}
                      </span>
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-5 py-8 sm:px-8">
      <slot />
      <p class="mt-12 text-center text-xs text-stone">
        مراحل الطلب: {Object.values(orderStatusLabel).join(' ← ')}
      </p>
    </main>
  </body>
</html>
