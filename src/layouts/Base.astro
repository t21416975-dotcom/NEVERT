---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
}

const {
  title,
  description = 'Handcrafted luxury bags, made one at a time.',
  lang = 'en',
  dir = 'ltr',
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Apply the saved language before first paint so there's no flash
      // of LTR/English over the hero while Astro loads.
      try {
        const l = localStorage.getItem('nevert-lang');
        const ar = l === 'ar';
        document.documentElement.lang = ar ? 'ar' : 'en';
        document.documentElement.dir = ar ? 'rtl' : 'ltr';
      } catch (e) {}
    </script>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot name="header" />
    <main class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      // Minimal reveal-on-scroll, once per element
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
            document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
    <script>
      import { applyLang, getStoredLang } from '../lib/i18n';
      applyLang(getStoredLang());
    </script>
  </body>
</html>
