---
import Admin from '../../layouts/Admin.astro';
import StatusPill from '../../components/admin/StatusPill.astro';
import { orderCounts, listOrders, ordersReady } from '../../lib/admin-data';
import { formatPrice } from '../../lib/types';
import { orderMessage, waLink } from '../../lib/format';
import { formatDay, ordersLabel, piecesLabel } from '../../lib/labels';

const [counts, orders] = await Promise.all([orderCounts(), listOrders()]);
const latest = orders.slice(0, 6);
const admin = Astro.locals.admin;
const openCount = counts.new + counts.open;

const stats = [
  { label: 'طلبات جديدة', value: String(counts.new), hot: counts.new > 0 },
  { label: 'تحت التواصل', value: String(counts.open), hot: false },
  { label: 'تم التسليم', value: String(counts.delivered), hot: false },
  { label: 'قيمة المُسلَّم', value: formatPrice(counts.revenue), hot: false },
];

const actions = [
  { href: '/admin/products#new', title: '＋ إضافة منتج', sub: 'اسم عربي وإنجليزي وسعر بالجنيه' },
  { href: '/admin/collections', title: 'المجموعات', sub: 'تعديل الأسماء والصور' },
  { href: '/admin/orders?status=new', title: 'طلبات جديدة', sub: openCount === 0 ? 'لا يوجد ما ينتظر' : `${ordersLabel(openCount)} تحتاج ردًا` },
];
---

<Admin title="الطلبات — لوحة تحكم NEVERT" email={admin?.email} newOrders={counts.new}>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-3xl text-espresso">اليوم في الورشة</h1>
      <p class="mt-2 text-sm leading-relaxed text-stone">
        افتح محادثة واتساب مع العميل، وبعدها انقل الطلب بين المراحل.
      </p>
    </div>
  </div>

  {
    !ordersReady() && (
      <p class="admin-alert mt-6">
        قاعدة بيانات الطلبات غير متصلة. أضف PUBLIC_SUPABASE_URL و
        SUPABASE_SERVICE_ROLE_KEY، ونفّذ ملف supabase/schema.sql، ثم أعد تحميل
        الصفحة.
      </p>
    )
  }

  <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
    {stats.map((s) => (
      <div class="admin-card !p-5">
        <dt class="text-sm text-stone">{s.label}</dt>
        <dd class={`latin mt-2 text-3xl tabular-nums ${s.hot ? 'text-cognac' : 'text-espresso'}`}>{s.value}</dd>
      </div>
    ))}
  </dl>

  <section class="mt-8 grid gap-4 sm:grid-cols-3">
    {actions.map((a) => (
      <a href={a.href} class="admin-row">
        <div>
          <p class="text-espresso">{a.title}</p>
          <p class="mt-1 text-xs text-stone">{a.sub}</p>
        </div>
      </a>
    ))}
  </section>

  <section class="admin-card mt-8">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 class="admin-section-title">أحدث الطلبات</h2>
      <a
        href="/admin/orders"
        class="text-sm text-stone underline decoration-stone/30 underline-offset-4 hover:text-cognac"
      >
        كل الطلبات ({ordersLabel(orders.length)})
      </a>
    </div>

    {
      latest.length === 0 ? (
        <p class="mt-4 text-sm leading-relaxed text-stone">
          لا توجد طلبات بعد. عندما يرسل عميل طلبًا من صفحة السلة سيظهر هنا
          مباشرة.
        </p>
      ) : (
        <ul class="mt-4 divide-y divide-espresso/10 border-t border-espresso/10">
          {latest.map((o) => (
            <li class="flex flex-wrap items-center justify-between gap-4 py-4">
              <div class="min-w-0">
                <a
                  href={`/admin/orders/${o.id}`}
                  class="text-lg text-espresso hover:text-cognac"
                >
                  #{o.id} — {o.customer_name}
                </a>
                <p class="mt-1 text-sm text-stone">
                  {piecesLabel(o.items.length)} ·{' '}
                  <span class="latin">{formatPrice(Number(o.total))}</span> ·{' '}
                  {formatDay(o.created_at)}
                </p>
              </div>
              <div class="flex items-center gap-3">
                <StatusPill status={o.status} />
                <a
                  href={waLink(o.whatsapp_number, orderMessage(o))}
                  target="_blank"
                  rel="noopener"
                  class="admin-btn-ghost !px-4 !py-2 text-xs"
                >
                  واتساب
                </a>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Admin>
