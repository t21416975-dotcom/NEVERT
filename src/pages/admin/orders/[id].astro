---
import Admin from '../../../layouts/Admin.astro';
import StatusPill from '../../../components/admin/StatusPill.astro';
import { getOrder } from '../../../lib/admin-data';
import { ORDER_STATUSES, formatPrice } from '../../../lib/types';
import { orderMessage, waLink } from '../../../lib/format';
import { formatDateTime, orderStatusLabel, piecesLabel } from '../../../lib/labels';

const id = Number(Astro.params.id);
const order = Number.isFinite(id) ? await getOrder(id) : null;
const admin = Astro.locals.admin;

if (!order) {
  return Astro.redirect('/admin/orders');
}

const saved = Astro.url.searchParams.get('saved');
const error = Astro.url.searchParams.get('error');
const message = orderMessage(order);
---

<Admin title={`طلب #${order.id} — لوحة تحكم NEVERT`} email={admin?.email}>
  <a
    href="/admin/orders"
    class="text-sm text-stone underline decoration-stone/30 underline-offset-4 hover:text-cognac"
  >
    ← رجوع إلى الطلبات
  </a>

  <div class="admin-card mt-4">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-3xl text-espresso">{order.customer_name}</h1>
          <StatusPill status={order.status} />
        </div>
        <p class="mt-2 text-sm text-stone">
          طلب #{order.id} · {formatDateTime(order.created_at)} · {piecesLabel(order.items.length)}
        </p>
      </div>
      <a
        href={waLink(order.whatsapp_number, message)}
        target="_blank"
        rel="noopener"
        class="admin-btn"
      >
        افتح محادثة واتساب
      </a>
    </div>

    {saved && <p class="admin-ok mt-5">تم الحفظ.</p>}
    {error && <p role="alert" class="admin-alert mt-5">تعذّر الحفظ، حاول مرة أخرى.</p>}

    <div class="mt-7 grid gap-8 border-t border-espresso/10 pt-7 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <h2 class="admin-section-title">القطع ({order.items.length})</h2>
        <ul class="mt-4 divide-y divide-espresso/10 border-y border-espresso/10">
          {order.items.map((item) => (
            <li class="flex items-baseline justify-between gap-6 py-3.5">
              <div>
                <p class="text-espresso">{item.name}</p>
                <p class="mt-0.5 text-sm text-stone">{item.color} · {item.size} · الكمية {item.qty}</p>
              </div>
              <p class="latin shrink-0 text-sm tabular-nums text-espresso">
                {formatPrice(Number(item.line_total))}
              </p>
            </li>
          ))}
        </ul>
        <div class="mt-4 flex items-baseline justify-between rounded-xl bg-linen/60 px-4 py-3">
          <span class="text-espresso">الإجمالي</span>
          <span class="latin text-2xl tabular-nums text-espresso">{formatPrice(Number(order.total))}</span>
        </div>
        <p class="admin-hint">سعر التوصيل غير محسوب؛ اتفق عليه مع العميل على واتساب.</p>
      </div>

      <div class="space-y-6">
        <div>
          <h2 class="admin-section-title">بيانات العميل</h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-6 border-b border-espresso/10 pb-3">
              <dt class="text-stone">رقم واتساب</dt>
              <dd class="latin text-espresso">{order.whatsapp_number}</dd>
            </div>
            <div class="flex justify-between gap-6 border-b border-espresso/10 pb-3">
              <dt class="text-stone">المدينة والعنوان</dt>
              <dd class="max-w-[60%] text-right text-espresso">{order.city ?? '—'}</dd>
            </div>
          </dl>
        </div>

        <form method="post" action="/api/admin/orders/status">
          <input type="hidden" name="id" value={order.id} />
          <input type="hidden" name="back" value={`/admin/orders/${order.id}`} />
          <label for="status" class="admin-label">حالة الطلب</label>
          <select id="status" name="status" class="admin-input">
            {ORDER_STATUSES.map((s) => (
              <option value={s} selected={s === order.status}>{orderStatusLabel[s]}</option>
            ))}
          </select>
          <button type="submit" class="admin-btn mt-3 w-full">حفظ الحالة</button>
        </form>

        <form method="post" action="/api/admin/orders/notes">
          <input type="hidden" name="id" value={order.id} />
          <label for="notes" class="admin-label">ملاحظات العميل</label>
          <textarea
            id="notes"
            name="notes"
            rows={3}
            placeholder="نقش الاسم، وقت توصيل مفضّل، إهداء"
            class="admin-input"
          >{order.notes ?? ''}</textarea>
          <button type="submit" class="admin-btn-ghost mt-3 w-full">حفظ الملاحظات</button>
        </form>
      </div>
    </div>
  </div>
</Admin>
