---
import Admin from '../../../layouts/Admin.astro';
import StatusPill from '../../../components/admin/StatusPill.astro';
import { listOrders, orderCounts } from '../../../lib/admin-data';
import { ORDER_STATUSES, formatPrice, type OrderStatus } from '../../../lib/types';
import { orderMessage, waLink } from '../../../lib/format';
import { formatDateTime, orderStatusLabel, ordersLabel } from '../../../lib/labels';

const filterParam = Astro.url.searchParams.get('status');
const filter = ORDER_STATUSES.includes(filterParam as OrderStatus)
  ? (filterParam as OrderStatus)
  : undefined;

const [orders, counts] = await Promise.all([listOrders(filter), orderCounts()]);
const admin = Astro.locals.admin;
const saved = Astro.url.searchParams.get('saved');
const error = Astro.url.searchParams.get('error');

const countFor = (status: OrderStatus) =>
  status === 'new'
    ? counts.new
    : status === 'delivered'
      ? counts.delivered
      : status === 'cancelled'
        ? counts.cancelled
        : status === 'contacted' || status === 'confirmed'
          ? counts.open
          : 0;
---

<Admin title="الطلبات — لوحة تحكم NEVERT" email={admin?.email} newOrders={counts.new}>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-3xl text-espresso">الطلبات</h1>
      <p class="mt-2 text-sm text-stone">{ordersLabel(orders.length)}</p>
    </div>
  </div>

  {saved && <p class="admin-ok mt-6">تم تحديث الطلب.</p>}
  {error && (
    <p role="alert" class="admin-alert mt-6">
      {error === 'status'
        ? 'الحالة المطلوبة غير معروفة، اختر واحدة من القائمة.'
        : 'تعذّر حفظ التعديل، حاول مرة أخرى.'}
    </p>
  )}

  <nav class="mt-6 flex flex-wrap gap-2" aria-label="تصفية حسب الحالة">
    <a href="/admin/orders" class={!filter ? 'admin-filter-active' : 'admin-filter'}>
      الكل
    </a>
    {ORDER_STATUSES.map((s) => (
      <a
        href={`/admin/orders?status=${s}`}
        class={filter === s ? 'admin-filter-active' : 'admin-filter'}
      >
        {orderStatusLabel[s]}
        {countFor(s) > 0 && <span class="latin mr-1 text-xs">({countFor(s)})</span>}
      </a>
    ))}
  </nav>

  {orders.length === 0 ? (
    <p class="admin-card mt-6 text-sm text-stone">لا توجد طلبات هنا بعد.</p>
  ) : (
    <ul class="mt-6 space-y-4">
      {orders.map((o) => (
        <li class="admin-card !p-5">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-3">
                <a href={`/admin/orders/${o.id}`} class="text-lg text-espresso hover:text-cognac">
                  #{o.id} — {o.customer_name}
                </a>
                <StatusPill status={o.status} />
              </div>
              <p class="mt-1.5 text-sm text-stone">
                <span class="latin">{o.whatsapp_number}</span>
                {o.city ? ` · ${o.city}` : ''} · {formatDateTime(o.created_at)}
              </p>
              <p class="mt-1.5 text-sm text-stone">
                {o.items.map((i) => `${i.name} (${i.color}، ${i.size}) × ${i.qty}`).join(' · ')}
              </p>
            </div>
            <div class="flex flex-col items-end gap-2">
              <p class="latin text-xl tabular-nums text-espresso">{formatPrice(Number(o.total))}</p>
              <a
                href={waLink(o.whatsapp_number, orderMessage(o))}
                target="_blank"
                rel="noopener"
                class="admin-btn-ghost !px-4 !py-2 text-xs"
              >
                واتساب
              </a>
            </div>
          </div>

          <form
            method="post"
            action="/api/admin/orders/status"
            class="mt-4 flex flex-wrap items-center gap-2 border-t border-espresso/10 pt-4"
          >
            <input type="hidden" name="id" value={o.id} />
            <input type="hidden" name="back" value="/admin/orders" />
            <label class="text-xs text-stone" for={`status-${o.id}`}>نقل إلى:</label>
            <select id={`status-${o.id}`} name="status" class="admin-input !mt-0 !w-auto !py-2 text-xs">
              {ORDER_STATUSES.map((s) => (
                <option value={s} selected={s === o.status}>{orderStatusLabel[s]}</option>
              ))}
            </select>
            <button type="submit" class="admin-btn !px-4 !py-2 text-xs">حفظ</button>
          </form>
        </li>
      ))}
    </ul>
  )}
</Admin>
