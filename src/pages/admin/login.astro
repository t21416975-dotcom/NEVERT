---
import Base from '../../layouts/Base.astro';
import { authReady } from '../../lib/auth';

const params = Astro.url.searchParams;
const error = params.get('error');
const next = params.get('next') ?? '/admin';

const message =
  error === 'missing'
    ? 'اكتب البريد الإلكتروني وكلمة المرور للمتابعة.'
    : error === 'invalid'
      ? 'البريد الإلكتروني أو كلمة المرور غير صحيحة.'
      : error === 'session'
        ? 'انتهت الجلسة، سجّل الدخول من جديد.'
        : '';
---

<Base title="تسجيل الدخول — لوحة تحكم NEVERT" lang="ar" dir="rtl">
  <style is:global>
    body {
      font-family: 'IBM Plex Sans Arabic', system-ui, sans-serif;
    }
    h1 {
      font-family: Amiri, 'IBM Plex Sans Arabic', serif;
      letter-spacing: 0;
    }
  </style>

  <div class="flex min-h-screen items-center justify-center px-5 py-16">
    <div class="w-full max-w-sm">
      <a href="/" class="font-display text-2xl tracking-[0.22em] text-espresso">
        NEVERT
      </a>
      <h1 class="mt-8 text-3xl text-espresso">لوحة تحكم الورشة</h1>
      <p class="mt-3 text-sm leading-relaxed text-stone">
        الطلبات والمنتجات والمجموعات. الحسابات تُنشأ من Supabase.
      </p>

      {
        !authReady && (
          <p class="mt-6 border border-cognac/40 bg-cognac/5 px-4 py-3 text-sm text-espresso">
            مفاتيح Supabase غير مضبوطة، لذلك تسجيل الدخول لا يعمل الآن. أضف
            PUBLIC_SUPABASE_URL و PUBLIC_SUPABASE_ANON_KEY إلى متغيرات البيئة.
          </p>
        )
      }

      {
        message && (
          <p
            role="alert"
            class="mt-6 border border-cognac/40 bg-cognac/5 px-4 py-3 text-sm text-espresso"
          >
            {message}
          </p>
        )
      }

      <form method="post" action="/api/admin/login" class="mt-8 space-y-5">
        <input type="hidden" name="next" value={next} />
        <div>
          <label for="email" class="block text-sm text-espresso">
            البريد الإلكتروني
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            dir="ltr"
            autocomplete="username"
            class="mt-2 w-full border border-espresso/20 bg-porcelain px-4 py-3 text-sm outline-none transition-colors focus:border-cognac"
          />
        </div>
        <div>
          <label for="password" class="block text-sm text-espresso">كلمة المرور</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            dir="ltr"
            autocomplete="current-password"
            class="mt-2 w-full border border-espresso/20 bg-porcelain px-4 py-3 text-sm outline-none transition-colors focus:border-cognac"
          />
        </div>
        <button
          type="submit"
          class="w-full bg-espresso px-8 py-4 text-sm text-porcelain transition-colors hover:bg-cognac"
        >
          تسجيل الدخول
        </button>
      </form>

      <p class="mt-8 text-xs text-stone">
        <a
          href="/"
          class="underline decoration-stone/30 underline-offset-4 hover:text-cognac"
        >
          رجوع إلى المتجر
        </a>
      </p>
    </div>
  </div>
</Base>
