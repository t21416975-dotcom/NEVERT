---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import {
  getCollectionBySlug,
  listCollections,
  productsInCollection,
} from '../../lib/store';

const { slug } = Astro.params;
const collection = await getCollectionBySlug(slug ?? '');

if (!collection) {
  return Astro.redirect('/collections');
}

const [items, all] = await Promise.all([
  productsInCollection(collection.slug),
  listCollections(),
]);
const others = all.filter((c) => c.slug !== collection.slug);
---

<Base title={`${collection.name} — NEVERT`} description={collection.description}>
  <Header slot="header" />

  <section class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <div class="overflow-hidden bg-linen">
      <img
        src={collection.cover}
        alt={collection.name}
        data-en={collection.name}
        data-ar={collection.name_ar || collection.name}
        data-en-attr="alt"
        data-ar-alt={collection.name_ar || collection.name}
        width="1600"
        height="900"
        class="h-[42vh] min-h-[16rem] w-full object-cover sm:h-[52vh]"
      />
    </div>

    <div class="mt-10 sm:flex sm:items-end sm:justify-between sm:gap-12">
      <div>
        <h1
          class="font-display text-4xl text-espresso sm:text-5xl"
          data-en={collection.name}
          data-ar={collection.name_ar || collection.name}
        >
          {collection.name}
        </h1>
        <p
          class="mt-3 text-sm text-cognac"
          data-en={collection.tagline}
          data-ar={collection.tagline_ar || collection.tagline}
        >{collection.tagline}</p>
      </div>
      <p
        class="mt-5 max-w-md leading-relaxed text-stone sm:mt-0"
        data-en={collection.description}
        data-ar={collection.description_ar || collection.description}
      >
        {collection.description}
      </p>
    </div>

    <p
      class="mt-10 border-t border-espresso/10 pt-6 text-sm text-stone"
      data-l10n-count={items.length}
      data-l10n-kind="pieces"
    >
      {items.length} pieces
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-8 sm:px-8">
    <div class="grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-6 lg:grid-cols-3">
      {items.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-24 sm:px-8">
    <h2 data-i18n="collections.also" class="font-display text-2xl text-espresso">Also in the workshop</h2>
    <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
      {
        others.map((c) => (
          <a
            href={`/collections/${c.slug}`}
            class="text-espresso underline decoration-espresso/25 underline-offset-4 hover:text-cognac hover:decoration-cognac/50"
          >
            <span data-en={c.name} data-ar={c.name_ar || c.name}>{c.name}</span>
            {' — '}
            <span data-en={c.tagline} data-ar={c.tagline_ar || c.tagline}>{c.tagline}</span>
          </a>
        ))
      }
    </div>
  </section>

  <Footer slot="footer" />
</Base>
