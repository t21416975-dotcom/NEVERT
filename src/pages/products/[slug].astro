---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductActions from '../../components/ProductActions.tsx';
import { getProductBySlug, getCollectionBySlug, listProducts } from '../../lib/store';
import { formatPrice } from '../../lib/types';
import { getCollection } from '../../data/catalog';

const { slug } = Astro.params;
const product = await getProductBySlug(slug ?? '');

if (!product) {
  return Astro.redirect('/collections');
}

const collection =
  (await getCollectionBySlug(product.collection)) ??
  getCollection(product.collection) ?? {
    slug: product.collection,
    name: product.collection,
    tagline: '',
    description: '',
    cover: '',
  };
const related = (await listProducts())
  .filter((p) => p.slug !== product.slug)
  .slice(0, 3);
const colorNames = Array.from(new Set(product.variants.map((v) => v.color)));
const colorNamesAr = Array.from(
  new Set(product.variants.map((v) => (v.color_ar?.trim() ? v.color_ar : v.color)))
);
const nameAr = product.name_ar ?? '';
const descAr = product.description_ar ?? '';
const collNameAr = (collection as { name_ar?: string }).name_ar ?? collection.name;
---

<Base title={`${product.name} — NEVERT`} description={product.description}>
  <Header slot="header" />

  <nav
    aria-label="Breadcrumb"
    class="mx-auto max-w-6xl px-5 pt-8 text-xs text-stone sm:px-8"
  >
    <a href="/collections" class="hover:text-cognac" data-i18n="product.breadcrumb">Collections</a>
    <span class="px-2">/</span>
    <a href={`/collections/${collection.slug}`} class="hover:text-cognac" data-en={collection.name} data-ar={collNameAr}>
      {collection.name}
    </a>
    <span class="px-2">/</span>
    <span class="text-espresso" data-en={product.name} data-ar={nameAr || product.name}>{product.name}</span>
  </nav>

  <section class="mx-auto max-w-6xl px-5 pt-8 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <!-- Gallery: Gucci-style stage + thumbnails -->
      <ProductGallery
        images={product.images}
        name={product.name}
        nameAr={nameAr}
        colorEn={colorNames[0]}
        colorAr={colorNamesAr[0]}
      />

      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="text-xs tracking-[0.06em] text-cognac" data-en={collection.name} data-ar={collNameAr}>{collection.name}</p>
        <h1
          class="mt-3 font-display text-4xl text-espresso sm:text-5xl"
          data-en={product.name}
          data-ar={nameAr || product.name}
        >
          {product.name}
        </h1>
        <p class="mt-4 text-lg tabular-nums text-espresso" data-l10n-price={product.price}>
          {formatPrice(product.price)}
        </p>
        <p
          class="mt-6 max-w-md leading-relaxed text-stone"
          data-en={product.description}
          data-ar={descAr || product.description}
        >
          {product.description}
        </p>

        <ProductActions
          client:load
          slug={product.slug}
          name={product.name}
          name_ar={nameAr}
          price={product.price}
          image={product.images[0]}
          variants={product.variants}
        />

        <p data-i18n="product.note" class="mt-5 text-sm text-stone">
          You send your details, we confirm everything over WhatsApp before
          anything is charged or shipped.
        </p>

        <dl class="mt-10 divide-y divide-espresso/10 border-t border-espresso/10">
          <div class="py-4">
            <dt data-i18n="product.materials.title" class="text-sm text-espresso">Materials</dt>
            <dd data-i18n="product.materials.body" class="mt-2 text-sm leading-relaxed text-stone">
              Vegetable-tanned full-grain leather, undyed cotton thread, solid
              brass hardware. Lined in raw silk on the Atelier and Evening lines.
            </dd>
          </div>
          <div class="py-4">
            <dt data-i18n="product.delivery.title" class="text-sm text-espresso">Delivery and returns</dt>
            <dd data-i18n="product.delivery.body" class="mt-2 text-sm leading-relaxed text-stone">
              Made to order, 7–12 days. Delivery is quoted per city when we
              confirm your order. Returns within 14 days on unused pieces.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-24 sm:px-8">
    <h2 data-i18n="product.related" class="font-display text-2xl text-espresso">Others on the bench</h2>
    <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-6 lg:grid-cols-3">
      {related.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <Footer slot="footer" />
</Base>
